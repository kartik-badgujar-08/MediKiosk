# ==========================================
# MediKiosk - Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME=MediKiosk
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MongoDB)
# Local: mongodb://localhost:27017/medikiosk
# Cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/medikiosk?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medikiosk
DB_NAME=medikiosk

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Multilingual ASR (Speech-to-Text)
# Options: mock | indicconformer | bhashini
ASR_MODE=mock
ASR_PROVIDER=indicconformer
ASR_SERVICE_URL=

# Document OCR (PaddleOCR & PP-StructureV3)
# Options: mock | paddleocr | trocr
OCR_MODE=mock
OCR_PROVIDER=paddleocr

# Clinical NER & Concept Extraction (MedCAT)
# Options: mock | medcat | rule_based
CLINICAL_NER_MODE=mock
MEDCAT_MODEL_PACK=

# LLM Summary & Dialogue Generation
# Options: mock | qwen | llama | ollama | openai-compatible
LLM_MODE=mock
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=qwen2.5-7b-instruct

# Interoperability & External Standards
# FHIR R4 Base URL
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# ABDM (Ayushman Bharat Digital Mission) Integration
# Options: mock | sandbox | live
ABDM_MODE=mock
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=

# HIS (Hospital Information System) Integration
# Options: mock | webhook | rest
HIS_MODE=mock
HIS_ENDPOINT_URL=
HIS_API_KEY=

# Accessibility: Indian Sign Language Recognition
# Options: mock | mediapipe | islrtc
SIGN_RECOGNITION_MODE=mock
