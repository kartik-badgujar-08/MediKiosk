# ==============================================================================
# MediKiosk Enterprise Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database (MongoDB or native local disk persistence)
MONGODB_URI=mongodb://localhost:27017/medikiosk
DB_NAME=medikiosk

# Security
JWT_SECRET=supersecret_dev_jwt_key_change_in_production_min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# 100% FREE AI & LLM PROVIDERS FOR PRODUCTION / LIVE DEPLOYMENT
# ==============================================================================

# 1. MediKiosk Deterministic Clinical Synthesis Engine (DEFAULT)
# 100% Free, Built-in, 0ms latency, zero API keys required, zero hallucination.
LLM_PROVIDER=engine

# 2. Google Gemini Free Tier (1,500 free requests/day, MedQA 91.1%)
# Get your free key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Groq Cloud Free Tier (Ultra-fast Llama 3.3 70B, 30 req/min, 14,400 req/day)
# Get your free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Local Medical LLM via Ollama (BioMistral 7B / Llama 3 on Hospital Intranet)
# 100% on-premise, zero internet required, DPDP Act 2023 compliant.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=biomistral

# 5. OpenRouter Free Tier / Hugging Face Inference API
# OpenRouter offers free models ending in :free (e.g., google/gemini-2.0-flash-exp:free)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=google/gemini-2.0-flash-exp:free
